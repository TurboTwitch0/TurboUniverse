# Optional Vercel configuration. Public browsing and on-device AI need no secrets.
# In Vercel: Storage -> Create Database -> Blob -> Private -> connect to this project.
# Vercel supplies BLOB_READ_WRITE_TOKEN after connecting the store.
# BLOB_READ_WRITE_TOKEN=

# Set a long random owner key in Vercel's Environment Variables, then redeploy.
# Enter the same key only in the site's Manage collection dialog.
# TURBO_ADMIN_KEY=
