{
  "name": "turbo-universe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-interface-foundry.mjs",
    "predev": "node scripts/build-interface-foundry.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs tests/*.test.mjs",
    "test:import": "python3 scripts/import-turbohome.test.py",
    "test:ui": "node scripts/smoke.mjs",
    "test:vercel": "node scripts/smoke-vercel.mjs",
    "test:features": "node scripts/smoke-features.mjs",
    "test:discovery": "node scripts/smoke-discovery.mjs",
    "test:ai": "node scripts/smoke-ai.mjs",
    "test:launchpad": "node scripts/smoke-launchpad.mjs",
    "test:owner-session": "node scripts/smoke-owner-session.mjs",
    "test:local-ai": "node scripts/smoke-local-ai.mjs",
    "test:brand": "node scripts/smoke-brand.mjs",
    "test:orbital": "node scripts/smoke-orbital-stage.mjs",
    "test:foundry": "node scripts/smoke-interface-foundry.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@mlc-ai/web-llm": "0.2.86",
    "@vercel/blob": "^2.8.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
